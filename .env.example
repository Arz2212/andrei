# Public App URL & Supabase Client
NEXT_PUBLIC_APP_URL=https://life.vector-bd.top
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_your_key

# Owner Lock (Single-User Auth & Bot Session)
OWNER_USER_ID=00000000-0000-0000-0000-000000000000
OWNER_EMAIL=owner@example.com
OWNER_PASSWORD=change_me

# Telegram Bot
TELEGRAM_BOT_TOKEN=0000000000:replace_with_bot_token
ALLOWED_TELEGRAM_USER_ID=0
ALLOWED_TELEGRAM_GROUP_ID=

# AI Providers (DeepSeek primary + Polza.ai audio/fallback)
DEEPSEEK_API_KEY=sk-replace_me
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
POLZA_API_KEY=pza_replace_me
POLZA_BASE_URL=https://api.polza.ai/api/v1
